{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "auto",
        "source": "/home/x/.config/fastfetch/accii.txt"
    },

    "display": {
        "separator": "  ",
        "color": "blue"
    },
    "modules": [
        "break",
        "break",
        {
            "type": "custom",
            "format": "──────────────────────────────────────"
        },
        {
            "type": "custom",
            "format": "      We Live  We Love  We Lie"
        },
        {
            "type": "custom",
            "format": "──────────────────────────────────────"
        },
        {
            "type": "os",
            "key": "󰣇",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": "",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": "",
            "format": "{all}",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "──────────────────────────────────────"
        },
        {
            "type": "board",
            "key": "󰠾",
            "keyColor": "white"
        },
        {
            "type": "cpu",
            "key": "",
            "showPeCoreCount": true,
            "keyColor": "red"
        },
        {
            "type": "gpu",
            "key": "󰍹",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "",
            "keyColor": "magenta"
        },
        {
            "type": "disk",
            "key": "󰋊",
            "folders": "/",
            "keyColor": "cyan"
        },
        {
            "type": "disk",
            "key": "󰨣",
            "folders": "/mnt/backup",
            "keyColor": "yellow"
        },
        {
            "type": "custom",
            "format": "──────────────────────────────────────"
        },
        {
            "type": "custom",
            "format": "     {#90}󰫢  {#31}󰫢  {#32}󰫢  {#33}󰫢  {#34}󰫢  {#35}󰫢  {#36}󰫢  {#37}󰫢  {#38}󰫢  {#39}󰫢 "
        },
        {
            "type": "custom",
            "format": "──────────────────────────────────────"
        }
    ]
}